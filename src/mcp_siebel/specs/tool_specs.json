{
  "$defs": {
    "business_component": {
      "description": "Business Component within the Business Object. Defaults to the Business Object name itself when omitted.",
      "type": "string"
    },
    "business_object": {
      "description": "Siebel Business Object name, e.g. 'Account', 'Contact', 'Opportunity'. Call list_business_objects to see all available names.",
      "type": "string"
    },
    "child_business_component": {
      "description": "Name of a Business Component that is linked as a CHILD of the parent record under this Business Object \u2014 e.g. 'Contact' or 'Opportunity' under 'Account'. Must be a real child relationship of this Business Object, not an arbitrary Business Component.",
      "type": "string"
    },
    "data": {
      "description": "JSON object of field names to values for create/update, e.g. {\"Name\": \"Acme\"}.",
      "type": "object"
    },
    "fields": {
      "description": "List of REAL Siebel field names to return, e.g. [\"Name\", \"Status\"]. Look the valid names up with describe_business_object first. Omit to return the default field set. NEVER pass placeholders such as '<?>'; if you are unsure of the field names, call describe_business_object before querying.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "description": "Siebel row Id of the record, e.g. '1-5GZE'.",
      "type": "string"
    },
    "offset": {
      "description": "Zero-based row offset to start paging from, e.g. 100.",
      "type": "integer"
    },
    "page_size": {
      "description": "Page size 1-100, e.g. 20. Default 20.",
      "type": "integer"
    },
    "parent_id": {
      "description": "Siebel row Id of the parent record, e.g. '1-5GZE'.",
      "type": "string"
    },
    "searchspec": {
      "description": "Optional Siebel search expression, e.g. \"[Name] LIKE 'A*'\" or '[Id] = \"1-5GZE\"'. Omit to return all rows (paged).",
      "type": "string"
    },
    "sort_spec": {
      "description": "Optional sort expression, e.g. 'Name' or 'Created DESC'.",
      "type": "string"
    }
  },
  "preferred_fields": {
    "Contact": [
      "Last Name",
      "First Name",
      "Middle Name",
      "Job Title",
      "Primary Account Name",
      "Work Phone #",
      "Cellular Phone #",
      "Home Phone #",
      "Fax Phone #",
      "Email Address",
      "Primary Street Address",
      "Primary City",
      "Primary State",
      "Primary Postal Code",
      "Primary Country",
      "Status",
      "Comment"
    ],
    "Account": [
      "Name",
      "Account Status",
      "Type",
      "Main Phone Number",
      "Main Fax Number",
      "Home Page",
      "Primary Account Street Address",
      "Primary Account City",
      "Primary Account State",
      "Primary Account Postal Code",
      "Primary Account Country",
      "Primary Organization",
      "Annual Revenue",
      "Employees"
    ],
    "Opportunity": [
      "Name",
      "Account",
      "Sales Stage",
      "Primary Revenue Amount",
      "Primary Revenue Close Date",
      "Win Probability",
      "Primary Organization",
      "Sales Method",
      "Description"
    ],
    "Service Request": [
      "SR Number",
      "Abstract",
      "Status",
      "Substatus",
      "Priority",
      "Severity",
      "Account",
      "Contact Last Name",
      "Contact First Name",
      "Owner",
      "Description"
    ]
  },
  "tools": {
    "aggregate_data": {
      "description": "Compute sum, avg, min, max, or count across all matching records.",
      "handler": "mcp_siebel.handlers.records:_aggregate_data",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "field": {
            "description": "A real Siebel field name to aggregate over (from describe_business_object).",
            "type": "string"
          },
          "operation": {
            "description": "Aggregation operation: one of 'sum', 'avg', 'min', 'max', 'count'.",
            "type": "string"
          },
          "searchspec": {
            "$ref": "#/$defs/searchspec"
          }
        },
        "required": [
          "business_object",
          "field",
          "operation"
        ],
        "type": "object"
      },
      "kind": "python",
      "access": "read"
    },
    "authenticate": {
      "always_enabled": true,
      "establishes_session": true,
      "description": "Authenticate or register a Siebel user for this session.",
      "handler": "mcp_siebel.handlers.auth:_authenticate",
      "input_schema": {
        "properties": {
          "password": {
            "description": "Siebel password.",
            "type": "string"
          },
          "username": {
            "description": "Siebel user name.",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "kind": "python",
      "access": "read"
    },
    "calculate_date": {
      "description": "Resolve a natural-language date expression to MM/DD/YYYY.",
      "handler": "mcp_siebel.handlers.util:_calculate_date",
      "input_schema": {
        "properties": {
          "expression": {
            "description": "Natural-language date expression, e.g. 'today', 'next Monday', 'end of month'.",
            "type": "string"
          }
        },
        "required": [
          "expression"
        ],
        "type": "object"
      },
      "kind": "python",
      "access": "read"
    },
    "count_records": {
      "description": "Count records matching an optional searchspec.",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "searchspec": {
            "$ref": "#/$defs/searchspec"
          }
        },
        "required": [
          "business_object"
        ],
        "type": "object"
      },
      "kind": "bc_query",
      "access": "read",
      "scope": "root",
      "result": "count",
      "render": "count_prose"
    },
    "create_child_record": {
      "description": "Create child record(s) under a parent record.",
      "kind": "bc_upsert",
      "access": "write",
      "operation": "create",
      "scope": "child",
      "render": "child_create_prose",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "child_business_component": {
            "$ref": "#/$defs/child_business_component"
          },
          "data": {
            "$ref": "#/$defs/data"
          },
          "parent_id": {
            "$ref": "#/$defs/parent_id"
          }
        },
        "required": [
          "business_object",
          "parent_id",
          "child_business_component",
          "data"
        ],
        "type": "object"
      }
    },
    "create_record": {
      "description": "Create a new Siebel record.",
      "kind": "bc_upsert",
      "access": "write",
      "operation": "create",
      "scope": "root",
      "render": "create_prose",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "data": {
            "$ref": "#/$defs/data"
          }
        },
        "required": [
          "business_object",
          "data"
        ],
        "type": "object"
      }
    },
    "create_record_json": {
      "description": "Create a new Siebel record and return it as structured JSON (the new Id is in the result).",
      "kind": "bc_upsert",
      "access": "write",
      "operation": "create",
      "scope": "root",
      "render": "create_json",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "data": {
            "$ref": "#/$defs/data"
          }
        },
        "required": [
          "business_object",
          "data"
        ],
        "type": "object"
      }
    },
    "delete_record": {
      "description": "Delete a Siebel record by Id.",
      "kind": "bc_delete",
      "access": "delete",
      "render": "delete_prose",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "id": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "business_object",
          "id"
        ],
        "type": "object"
      }
    },
    "describe_business_object": {
      "description": "Get field schema for a Siebel Business Object/Component.",
      "kind": "bc_describe",
      "access": "read",
      "source": "bc_descriptor",
      "render": "describe_bc_prose",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          }
        },
        "required": [
          "business_object"
        ],
        "type": "object"
      }
    },
    "describe_business_object_json": {
      "description": "REST data API field list for a BC as JSON \u2014 the navigator's result-list columns (reliable; no LOV types).",
      "kind": "bc_describe",
      "access": "read",
      "source": "bc_descriptor",
      "render": "describe_bc_json",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          }
        },
        "required": [
          "business_object"
        ],
        "type": "object"
      }
    },
    "describe_repository": {
      "description": "Query Siebel repository metadata for the full field list of a Business Component. Returns richer data than describe_business_object: pre/post default values, LOV picklist types, calculated field flags, join info, and fields that are valid in searchspec/sort_spec but not returned by the REST data API. Always call this when you need fields not listed by describe_business_object, before create/update to check required field defaults, or when unsure about a field name or picklist values.",
      "kind": "bc_describe",
      "access": "read",
      "source": "repository",
      "render": "repository_prose",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          }
        },
        "required": [
          "business_object"
        ],
        "type": "object"
      }
    },
    "describe_repository_json": {
      "description": "Field metadata for a BC as JSON (name, type, LOV type, flags) \u2014 for the navigator's filter chips.",
      "kind": "bc_describe",
      "access": "read",
      "source": "repository",
      "render": "repository_json",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          }
        },
        "required": [
          "business_object"
        ],
        "type": "object"
      }
    },
    "get_list_of_values": {
      "description": "Fetch Siebel List of Values for LOV type codes.",
      "handler": "mcp_siebel.handlers.metadata:_get_list_of_values",
      "input_schema": {
        "properties": {
          "lov_types": {
            "description": "Siebel LOV type codes, e.g. [\"ACCOUNT_STATUS\"].",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "lov_types"
        ],
        "type": "object"
      },
      "kind": "python",
      "access": "read"
    },
    "get_query_syntax": {
      "description": "Return Siebel Query Language syntax reference.",
      "kind": "static_text",
      "access": "read",
      "text": [
        "Use <> for not equal; never use !=.",
        "Field names go in square brackets: [Status] = 'Open'.",
        "Use LIKE with * wildcards: [Name] LIKE 'Acme*'.",
        "Combine with AND/OR and parenthesize compound expressions.",
        "Dates may use Today(), Timestamp(), and arithmetic such as Today()-30.",
        "Siebel may return 404 when a query has no records."
      ],
      "input_schema": {
        "properties": {
          "user_question": {
            "description": "Natural-language question about Siebel query syntax (optional; ignored).",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "get_record": {
      "description": "Get a single Siebel record by Id.",
      "kind": "bc_read",
      "access": "read",
      "mode": "single",
      "render": "record_prose",
      "fallback": "curated_query",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "fields": {
            "$ref": "#/$defs/fields"
          },
          "id": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "business_object",
          "id"
        ],
        "type": "object"
      }
    },
    "get_record_with_children": {
      "description": "Get one record with embedded child records.",
      "kind": "bc_read",
      "access": "read",
      "mode": "with_children",
      "render": "record_hierarchical_prose",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "id": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "business_object",
          "id"
        ],
        "type": "object"
      }
    },
    "list_business_objects": {
      "description": "List all available Siebel Business Objects.",
      "kind": "bc_describe",
      "access": "read",
      "source": "business_objects",
      "render": "list_prose",
      "input_schema": {
        "properties": {},
        "type": "object"
      }
    },
    "list_business_objects_json": {
      "description": "List all available Siebel Business Objects as structured JSON (for the CRM navigator).",
      "kind": "bc_describe",
      "access": "read",
      "source": "business_objects",
      "render": "list_json",
      "input_schema": {
        "properties": {},
        "type": "object"
      }
    },
    "query_child_records": {
      "description": "Query child records under a parent record.",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "child_business_component": {
            "$ref": "#/$defs/child_business_component"
          },
          "fields": {
            "$ref": "#/$defs/fields"
          },
          "offset": {
            "$ref": "#/$defs/offset"
          },
          "page_size": {
            "$ref": "#/$defs/page_size"
          },
          "parent_id": {
            "$ref": "#/$defs/parent_id"
          },
          "searchspec": {
            "$ref": "#/$defs/searchspec"
          },
          "sort_spec": {
            "$ref": "#/$defs/sort_spec"
          }
        },
        "required": [
          "business_object",
          "parent_id",
          "child_business_component"
        ],
        "type": "object"
      },
      "kind": "bc_query",
      "access": "read",
      "scope": "child",
      "result": "records",
      "render": "child_query_prose"
    },
    "query_child_records_json": {
      "description": "Query child records and return structured JSON.",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "child_business_component": {
            "$ref": "#/$defs/child_business_component"
          },
          "fields": {
            "$ref": "#/$defs/fields"
          },
          "offset": {
            "$ref": "#/$defs/offset"
          },
          "page_size": {
            "$ref": "#/$defs/page_size"
          },
          "parent_id": {
            "$ref": "#/$defs/parent_id"
          },
          "searchspec": {
            "$ref": "#/$defs/searchspec"
          },
          "sort_spec": {
            "$ref": "#/$defs/sort_spec"
          }
        },
        "required": [
          "business_object",
          "parent_id",
          "child_business_component"
        ],
        "type": "object"
      },
      "kind": "bc_query",
      "access": "read",
      "scope": "child",
      "result": "records",
      "render": "query_json"
    },
    "query_data": {
      "description": "Query Siebel CRM data using a Siebel searchspec expression.",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "fields": {
            "$ref": "#/$defs/fields"
          },
          "offset": {
            "$ref": "#/$defs/offset"
          },
          "page_size": {
            "$ref": "#/$defs/page_size"
          },
          "searchspec": {
            "$ref": "#/$defs/searchspec"
          },
          "sort_spec": {
            "$ref": "#/$defs/sort_spec"
          }
        },
        "required": [
          "business_object"
        ],
        "type": "object"
      },
      "kind": "bc_query",
      "access": "read",
      "scope": "root",
      "result": "records",
      "render": "query_prose"
    },
    "query_records_json": {
      "description": "Query records and return structured JSON.",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "childlinks": {
            "description": "Child Business Component names to expand inline in the response.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "fields": {
            "$ref": "#/$defs/fields"
          },
          "offset": {
            "$ref": "#/$defs/offset"
          },
          "page_size": {
            "$ref": "#/$defs/page_size"
          },
          "searchspec": {
            "$ref": "#/$defs/searchspec"
          },
          "sort_spec": {
            "$ref": "#/$defs/sort_spec"
          }
        },
        "required": [
          "business_object"
        ],
        "type": "object"
      },
      "kind": "bc_query",
      "access": "read",
      "scope": "root",
      "result": "records",
      "render": "query_json"
    },
    "update_record": {
      "description": "Update an existing Siebel record by Id.",
      "kind": "bc_upsert",
      "access": "write",
      "operation": "update",
      "scope": "root",
      "render": "update_prose",
      "input_schema": {
        "properties": {
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "data": {
            "$ref": "#/$defs/data"
          },
          "id": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "business_object",
          "id",
          "data"
        ],
        "type": "object"
      }
    },
    "upload_attachment": {
      "description": "Upload a base64 file attachment to a Siebel record.",
      "handler": "mcp_siebel.handlers.children:_upload_attachment",
      "input_schema": {
        "properties": {
          "attachment_bc": {
            "description": "Business Component for the attachment, e.g. 'Account Attachment'.",
            "type": "string"
          },
          "business_component": {
            "$ref": "#/$defs/business_component"
          },
          "business_object": {
            "$ref": "#/$defs/business_object"
          },
          "comment": {
            "description": "Optional attachment comment.",
            "type": "string"
          },
          "file_content_base64": {
            "description": "Attachment file contents, base64-encoded.",
            "type": "string"
          },
          "file_ext": {
            "description": "Attachment file extension, e.g. 'pdf'.",
            "type": "string"
          },
          "file_name": {
            "description": "Attachment file name without extension.",
            "type": "string"
          },
          "parent_id": {
            "$ref": "#/$defs/parent_id"
          }
        },
        "required": [
          "business_object",
          "parent_id",
          "attachment_bc",
          "file_name",
          "file_ext",
          "file_content_base64"
        ],
        "type": "object"
      },
      "kind": "python",
      "access": "write"
    },
    "web_search": {
      "description": "Search the web using Brave Search when configured.",
      "handler": "mcp_siebel.handlers.util:_web_search",
      "input_schema": {
        "properties": {
          "count": {
            "description": "Number of web results to return, e.g. 5.",
            "type": "integer"
          },
          "query": {
            "description": "Web search query string.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "kind": "python",
      "access": "external"
    }
  }
}
