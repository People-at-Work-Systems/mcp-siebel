# Siebel connection (required)
SIEBEL_BASE_URL=https://siebel.example.com/siebel/v1.0
# SIEBEL_HOST=             # alternative to BASE_URL: host (+ scheme) to build the URL from
SIEBEL_SCHEME=https

# Mode / behavior
SIEBEL_MCP_MODE=standalone
SIEBEL_SSO_HEADER=SBL_USER
SIEBEL_LANGUAGE_CODE=ENU
SIEBEL_DEFAULT_PAGE_SIZE=20
SIEBEL_REQUEST_TIMEOUT_MS=30000
SIEBEL_MAX_CONCURRENT_REQUESTS=5
SIEBEL_MAX_QUEUE_DEPTH=50
SIEBEL_AGGREGATE_PAGE_SIZE=100
SIEBEL_AGGREGATE_MAX_PAGES=500
SIEBEL_SESSION_TIMEOUT_MS=1800000

# Auth probe (standalone mode) — a REST-enabled BO/BC a bogus SSO header cannot read
SIEBEL_PROBE_BUSINESS_OBJECT=Account
SIEBEL_PROBE_BUSINESS_COMPONENT=Account

# Access gates — all default off (read-only). Set to true to enable.
SIEBEL_ALLOW_WRITE=false
SIEBEL_ALLOW_DELETE=false
# External-service tools (e.g. web_search sends free text to Brave). Default off
# so customer data can't leave for an outside service without an explicit opt-in.
SIEBEL_ALLOW_EXTERNAL=false
# SIEBEL_DISABLED_TOOLS=   # additional comma-separated tool names to disable

# Optional bundled-prompt override
# SIEBEL_SYSTEM_PROMPT_PATH=/path/to/your-siebel-system.md

# Optional tool-spec override. The spec defines the COMPLETE tool set — each
# tool's kind, access level, handler reference, and input_schema, plus the
# optional top-level preferred_fields and $defs — not just per-tool
# description/inputSchema. Empty (default) = use the bundled
# mcp_siebel/specs/tool_specs.json. The bundled file carries a "$schema"
# pointing at tool_specs.schema.json for editor validation.
# SIEBEL_TOOLS_SPEC_PATH=/path/to/your-tool-specs.json

# Tool-spec hot-reload watcher (default true). A watchfiles watcher pushes spec
# changes to the registry as they happen: it watches the spec's directory and
# filters to the spec path (so an editor's atomic temp-file + rename replace is
# detected), debounces bursts ~300 ms, and reloads on a quiet change. Connected
# clients are notified — MCP clients get notifications/tools/list_changed (a
# hint; not every client re-lists immediately), and HTTP REST clients get an
# ETag/If-None-Match->304 on GET /tools and a tools_changed SSE event on
# GET /tools/events. A failed reload sends nothing and keeps the last valid set.
# Set false to disable the watcher; the lazy mtime check on the next tools/list
# or GET /tools still heals a missed change. Python handler modules are NOT
# watched; a code change still needs a restart — only the JSON spec is hot.
# SIEBEL_TOOLS_SPEC_WATCH=true

# OAuth (optional — for Siebel OAuth/Keycloak auth mode)
# SIEBEL_OAUTH_CLIENT_ID=
# SIEBEL_OAUTH_CLIENT_SECRET=
# SIEBEL_KEYCLOAK_TOKEN_URL=https://keycloak.example.com/realms/yourrealm/protocol/openid-connect/token

# Optional bearer-token guard on the HTTP server (unset = no auth)
# MCP_API_TOKEN=

# Optional extras
# SIEBEL_BRAVE_SEARCH_API_KEY=
# SIEBEL_API_TOKEN=
# SIEBEL_DEMO_ENABLED=false